{
  "name": "talnxt-forms-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that receives TalNXT website forms and stores them in Microsoft 365 via Graph.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
